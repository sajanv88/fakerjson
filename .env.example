# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public URL shown in Swagger "servers" (production: https://fakerjson.com; empty = relative URLs)
PUBLIC_BASE_URL=
# Proxies whose X-Forwarded-* headers are trusted. Comma-separated addresses,
# CIDRs or the names loopback / linklocal / uniquelocal, or "true".
# The default trusts private networks, which covers an AKS ingress controller.
TRUST_PROXY=loopback,linklocal,uniquelocal
# Comma-separated list of allowed origins, or * for any.
CORS_ORIGINS=*
# Keep above the ingress / load balancer idle timeout.
KEEP_ALIVE_TIMEOUT_MS=65000
# On SIGTERM, readiness returns 503 this long before shutdown (lets the ingress drain).
SHUTDOWN_DELAY_MS=5000
SWAGGER_ENABLED=true

# --- Redis (optional; without it cache and rate limits are per instance) -----
# Azure Cache for Redis: rediss://:<access-key>@<name>.redis.cache.windows.net:6380
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=fakerjson

# --- Response cache -----------------------------------------------------------
CACHE_TTL_MS=600000
CACHE_MEMORY_MAX_ITEMS=5000
HTTP_CACHE_MAX_AGE_S=300

# --- Rate limits (per client IP) ----------------------------------------------
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=300
RATE_LIMIT_BURST_TTL_MS=1000
RATE_LIMIT_BURST_LIMIT=25
RATE_LIMIT_WRITE_TTL_MS=60000
RATE_LIMIT_WRITE_LIMIT=60

# --- Data ---------------------------------------------------------------------
DEFAULT_SEED=42
MAX_DELAY_MS=10000
DATASET_CACHE_SIZE=64

# --- OpenTelemetry (off unless an endpoint is set) ------------------------------
# Run with: node --import ./dist/instrumentation.js dist/main.js  (pnpm start:prod does)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=fakerjson
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=none
